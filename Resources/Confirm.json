{    "name": "confirmDialog",    "windowTitle": "Warning",    "windowMinWidth": 400,    "windowMinHeight": 200,    "method": "loadConfirm",    "pages": [        null,        {            "objects": {                "title": {                    "type": "text",                    "text": "Define the title text",                    "left": 80,                    "top": 20,                    "width": 300,                    "height": 40,                    "fontTheme": "main",                    "sizingX": "grow",                    "sizingY": "fixed"                },                "subTitle": {                    "type": "text",                    "text": "Define the subTitle text",                    "left": 80,                    "top": 70,                    "width": 300,                    "height": 60,                    "fontTheme": "additional",                    "sizingX": "grow",                    "sizingY": "fixed"                },                "warningIcon": {                    "type": "picture",                    "left": 20,                    "top": 20,                    "width": 40,                    "height": 40,                    "pictureFormat": "scaled",                    "picture": "/RESOURCES/Images/Alert.png"                },                "btnOK": {                    "type": "button",                    "text": "OK",                    "left": 280,                    "top": 160,                    "width": 100,                    "height": 20,                    "defaultButton": true,                    "action": "Accept",                    "sizingX": "move",                    "sizingY": "move"                },                "btnCancel": {                    "type": "button",                    "text": "Cancel",                    "left": 160,                    "top": 160,                    "width": 100,                    "height": 20,                    "action": "Cancel",                    "sizingX": "move",                    "sizingY": "move"                }            }        }    ]}