{    "name": "outputForm",    "windowTitle": "Person",    "windowMinWidth": 340,    "windowMinHeight": 400,    "pages": [        null,        {            "objects": {                "btnAdd": {                    "type": "button",                    "text": "Add",                    "action": "addsubrecord",                    "style": "toolbar",                    "icon": "/RESOURCES/images/Buttons/LightGrey/NewRecord.png",                    "iconFrames": 4,                    "textPlacement": "bottom",                    "left":20,                     "top":20,                     "width":60,                     "height":60                },                "btnDelete": {                    "type": "button",                    "text": "Delete",                    "action": "deleteSubrecord",                    "style": "toolbar",                    "icon": "/RESOURCES/images/Buttons/LightGrey/DeleteSelection.png",                    "iconFrames": 4,                    "textPlacement": "bottom",                    "left":80,                     "top":20,                     "width":60,                     "height":60                },                "btnEdit": {                    "type": "button",                    "text": "Edit",                    "action": "editSubrecord",                    "style": "toolbar",                    "icon": "/RESOURCES/images/Buttons/LightGrey/Edit.png",                    "iconFrames": 4,                    "textPlacement": "bottom",                    "left":140,                     "top":20,                     "width":60,                     "height":60                },                "myListBox": {                    "type": "listbox",                    "listboxType": "currentSelection",                    "table": "Person",                    "left":20,                     "top":100,                     "width":300,                     "height":280,                    "highlightSet":"$ListboxSet",                    "doubleClickInRowAction": "displaySubrecord",                    "sizingX": "grow",                    "sizingY": "grow",                    "columns": [                     {                        "objectName": "colID",                        "dataSourceTypeHint": "text",                        "dataSource": "[Person]ID",                        "minWidth": 100,                        "maxWidth": 200,                        "resizable": true,                        "header": {                            "text": "ID"                        }                     },                      {                        "objectName": "colFirstname",                        "dataSourceTypeHint": "text",                        "dataSource": "[Person]firstname",                        "minWidth": 100,                        "maxWidth": 200,                        "resizable": true,                        "header": {                            "text": "Firstname"                        }                    },                     {                        "objectName": "colLastname",                        "dataSourceTypeHint": "text",                        "dataSource": "[Person]lastname",                        "minWidth": 100,                        "maxWidth": 200,                        "resizable": true,                        "header": {                            "text": "Lastname"                        }                    } ]                }            }        }    ]}